pragma solidity ^0.8.24;

import {KronosGuard} from "../KronosGuard.sol";
import {MiniLendCore} from "./MiniLendCore.sol";
import {IERC20} from "../interfaces/IERC20.sol";
import {SafeTransfer} from "../SafeTransfer.sol";

/// @title GuardConfigMiniLend
/// @notice GENERATED by the Kronos package builder (template: lending/compound-v2-style).
///         Wires MiniLend's state getters into the LendingInvariants templates. The approved parameters
///         live in `KronosGuard.params`; `kronosConfigHash()` must equal the approved package's config hash.
abstract contract GuardConfigMiniLend is KronosGuard, MiniLendCore {
    using SafeTransfer for IERC20;

    constructor(
        address base_,
        uint8 baseDecimals_,
        address timelock_,
        address registry_,
        address guardian_,
        address monitor_,
        GuardParams memory p
    ) KronosGuard(timelock_, registry_, guardian_, monitor_, p) MiniLendCore(base_, baseDecimals_) {}

    // ---- protocol <-> guard wiring

    function _kronosBeforeAction() internal override {
        accrue(); // so interest accrual never shows up as a share-price jump
    }

    function _kronosHealthBps(address a) internal view override returns (uint256) {
        return healthBps(a);
    }

    function _kronosLtvBps(address a) internal view override returns (uint256) {
        return ltvBps(a);
    }

    function _kronosTotalAssets() internal view override returns (uint256) {
        return cash() + totalBorrows();
    }

    function _kronosTotalLiabilities() internal view override returns (uint256) {
        return totalDeposits;
    }

    function _kronosSharePrice() internal view override returns (uint256) {
        return exchangeRate();
    }

    function _kronosBadDebt() internal view override returns (uint256) {
        return badDebt;
    }

    function _kronosPricedAssets(address a) internal view override returns (address[] memory out) {
        Account storage acc = accounts[a];
        if (acc.collateralAsset == address(0) || acc.debtNorm == 0) return new address[](0);
        out = new address[](1);
        out[0] = acc.collateralAsset;
    }

    function _kronosSpotPrice(address asset) internal view override returns (uint256) {
        return priceOf(asset);
    }

    function _kronosBorrowedAgainst(address asset) internal view override returns (uint256) {
        return borrowedAgainst(asset);
    }

    function _kronosCollateralCap(address asset) internal view override returns (uint256) {
        return markets[asset].cap;
    }

    function _kronosListedAt(address asset) internal view override returns (uint256) {
        return markets[asset].listedAt;
    }

    function _kronosAssetFrozen(address asset) internal view override returns (bool) {
        return asset != address(base) && markets[asset].frozen;
    }

    function _kronosUnderwaterDebt() internal view override returns (uint256) {
        return underwaterDebt();
    }

    function _kronosListedAssets() internal view override returns (address[] memory) {
        return marketList;
    }

    // ---- protocol hooks routed through the guard

    function _checkAdmin() internal view override {
        if (msg.sender != timelock) revert NotTimelock();
    }

    function _payout(address asset, address to, uint256 amount) internal override {
        _breakerPayout(asset, to, amount);
    }

    function _onInflow(address asset, uint256 amount) internal override {
        _breakerInflow(asset, amount);
    }

    function _pendingBase() internal view override returns (uint256) {
        return pendingOutflow[address(base)];
    }

    function _transferOut(address asset, address to, uint256 amount) internal override {
        IERC20(asset).safeTransfer(to, amount);
    }
}
