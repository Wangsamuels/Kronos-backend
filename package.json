{
  "name": "kronos-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Kronos backend: API, analysis workers, guard contracts and NEAR registry",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "dev:api": "tsx watch api/server.ts",
    "dev:worker": "tsx watch worker/index.ts",
    "start:api": "node dist/api/server.js",
    "start:worker": "node dist/worker/index.js",
    "migrate": "tsx db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "openapi": "tsx scripts/export-openapi.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:contracts": "cd contracts && forge test",
    "demo": "tsx scripts/demo.ts",
    "test:all": "npm run test:contracts && npm test",
    "kronos": "tsx scripts/kronos-cli.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1165.0",
    "@aws-sdk/s3-request-presigner": "^3.1165.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^10.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.9.3",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@octokit/app": "^16.1.4",
    "@octokit/rest": "^22.0.1",
    "archiver": "^7.0.1",
    "bullmq": "^6.7.2",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "near-api-js": "^5.1.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "viem": "^2.57.17",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "5.6",
    "vitest": "^5.1.0"
  }
}
