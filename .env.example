# ---- core (required in production)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kronos
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080
PORT=8080
# refresh cookie: SameSite=none when the frontend calls the API cross-site, lax when it proxies /api
COOKIE_SAMESITE=
COOKIE_PATH=/

# ---- local / judging
ALLOW_DEV_LOGIN=true
RPC_LOCAL=http://127.0.0.1:8545
# anvil accounts 3 and 4 (local only!)
ATTESTOR_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6
MONITOR_PRIVATE_KEY=0x47e179ec197488593b187f80a00eb0da91f1b9d0b13f8733639f19c30a34926a

# ---- LLM gateway (unset => deterministic heuristic agents)
LLM_PROVIDER=
NEAR_AI_API_KEY=
LLM_MODEL_A=z-ai/glm-5.3
LLM_MODEL_B=Qwen/Qwen3.6-35B-A3B-FP8
LLM_TOKEN_BUDGET=400000

# ---- GitHub (OAuth sign-in + App for private clones and PRs)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=

# ---- chains / explorers
RPC_AURORA_TESTNET=https://testnet.aurora.dev
RPC_BASE_SEPOLIA=https://sepolia.base.org
ETHERSCAN_API_KEY=

# ---- NEAR registry + tighten-only monitor key
NEAR_NETWORK=testnet
NEAR_REGISTRY_CONTRACT=kronos.testnet
NEAR_ACCOUNT_ID=
NEAR_FUNCTION_CALL_KEY=
# Chain Signatures: MPC signer (default v1.signer-prod.testnet on testnet) and auto|off
NEAR_MPC_SIGNER=
NEAR_CHAIN_SIGNATURES=auto
# NEP-413 recipient wallets sign for (defaults to FRONTEND_URL's host)
NEAR_SIGNIN_RECIPIENT=

# ---- storage (unset => stored in Postgres)
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=kronos

# ---- alerts
ALERT_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
